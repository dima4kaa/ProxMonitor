<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProxMonitor.App.SettingsWindow"
        Title="Настройки" Icon="/Assets/app.ico"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Пороги предупреждений" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
               Text="Значения для всех серверов. Для отдельного сервера их можно переопределить в его свойствах." />

    <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Text="Загрузка CPU, %" VerticalAlignment="Center" />
      <NumericUpDown x:Name="CpuBox" Grid.Column="1" Minimum="1" Maximum="100" Increment="5" FormatString="0" />
      <TextBlock Grid.Row="1" Text="Температура, °C" VerticalAlignment="Center" />
      <NumericUpDown x:Name="TempBox" Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="120" Increment="5" FormatString="0" />
      <TextBlock Grid.Row="2" Text="Заполнение диска, %" VerticalAlignment="Center" />
      <NumericUpDown x:Name="DiskBox" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="100" Increment="5" FormatString="0" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Отмена" Click="Cancel_Click" Padding="16,6" IsCancel="True" />
      <Button Classes="accent" Content="Сохранить" Click="Save_Click" Padding="16,6" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
