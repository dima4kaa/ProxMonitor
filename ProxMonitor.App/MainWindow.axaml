<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ProxMonitor.App"
        xmlns:core="using:ProxMonitor.Core"
        x:Class="ProxMonitor.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="ProxMonitor" Icon="/Assets/app.ico"
        Width="1440" Height="860" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="48"
        Background="{DynamicResource Bg}">

  <Window.Resources>
    <!-- No spreadsheet-style cell frame: the whole row is already highlighted. -->
    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,6,10,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!-- table -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0,4,0" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Hover}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle, DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Selected}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- sheet tabs -->
    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Selected}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- server chips -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>

    <!-- event log -->
    <Style Selector="ListBox.log ListBoxItem">
      <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- sections: group headers inside the table -->
    <Style Selector="DataGridRowGroupHeader">
      <Setter Property="IsPropertyNameVisible" Value="False" />
      <Setter Property="IsItemCountVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- node cards -->
    <Style Selector="Border.node">
      <Setter Property="Width" Value="250" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.node:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="Button.inspector">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- widgets -->
    <Style Selector="Border.widget">
      <Setter Property="Width" Value="250" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 6 24 0 #33000000" />
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <!-- label / value pairs in widgets, node cards and the inspector -->
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- A maximized window with an extended client area spills past the screen edges by OffScreenMargin. -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">
    <!-- Title bar: also the window drag area -->
    <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <DockPanel Margin="10,0,150,0">
        <!-- App menu, like DaVinci Resolve: click the name -->
        <Button DockPanel.Dock="Left" Classes="icon" Padding="6,5" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="22" Height="22" CornerRadius="6" Background="#5C7CFA">
              <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="ProxMonitor" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Foreground="{DynamicResource Muted}" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="{app:T 'Подключить сервер…'}" Click="ConnectServer" />
              <MenuItem Header="{app:T 'Открыть демо-кластер'}" Click="OpenDemo" />
              <Separator />
              <MenuItem Header="{app:T 'Виджеты…'}" Click="OpenWidgets" />
              <MenuItem Header="{app:T 'Настройки…'}" Click="OpenSettings" />
              <Separator />
              <MenuItem Header="{app:T 'Выход'}" Click="Exit_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Classes="search" Width="280" Margin="28,0,0,0" VerticalAlignment="Center"
                 Watermark="{app:T 'Поиск по имени или ноде  (Ctrl+F)'}" Text="{Binding Search}" KeyDown="Search_KeyDown">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,4,0"
                      Foreground="{DynamicResource Muted}" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ToggleButton Classes="icon" IsChecked="{Binding OnlyProblems}" ToolTip.Tip="{app:T 'Показать только проблемные'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="#F59E0B" />
              <TextBlock Text="{Binding ProblemsCount}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding InspectorOpen}" ToolTip.Tip="{app:T 'Инспектор  (Ctrl+I)'}">
            <PathIcon Data="{StaticResource IconPanel}" Width="15" Height="15" />
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding IsLogOpen}" ToolTip.Tip="{app:T 'Журнал событий'}">
            <PathIcon Data="{StaticResource IconBell}" Width="15" Height="15" />
          </ToggleButton>
          <Button Classes="icon" Click="ToggleTheme" ToolTip.Tip="{app:T 'Светлая / тёмная тема'}">
            <PathIcon Data="{StaticResource IconTheme}" Width="15" Height="15" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="18" Margin="24,0" VerticalAlignment="Center"
                    HorizontalAlignment="Center" IsVisible="{Binding HasSources}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="statValue" Text="{Binding NodesSummary}" />
            <TextBlock Classes="statLabel" Text="{app:T 'нод'}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="statValue" Text="{Binding GuestsSummary}" />
            <TextBlock Classes="statLabel" Text="{app:T 'VM и LXC'}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="statLabel" Text="CPU" />
            <TextBlock Classes="statValue" Text="{Binding CpuSummary}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="statLabel" Text="{app:T 'макс.'}" />
            <TextBlock Classes="statValue" Text="{Binding TempSummary}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom bar: sheet tabs and servers -->
    <Border DockPanel.Dock="Bottom" Height="40" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="8,0">
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Sources}" VerticalAlignment="Center"
                      ContextRequested="Sources_ContextRequested">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:SourceState">
              <Border Classes="chip" ToolTip.Tip="{app:T 'ПКМ — отключить сервер'}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                           Fill="{Binding Online, Converter={x:Static app:Converters.StatusBrush}}" />
                  <TextBlock Text="{Binding Title}" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                   ContextRequested="Tabs_ContextRequested">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:SheetTab">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="muted" Text="{Binding Count}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="NewTabButton" Classes="icon" ToolTip.Tip="{app:T 'Новая вкладка'}">
            <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" />
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Spacing="10" Width="230">
                  <TextBlock Text="{app:T 'Новая вкладка'}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding NewTabName}" Watermark="{app:T 'Например, Продакшн'}" KeyDown="NewTab_KeyDown" />
                  <Button Classes="accent" Content="{app:T 'Создать'}" HorizontalAlignment="Right" Click="CreateTab_Click" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Nodes: physical hosts as cards; click one to see only its guests -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" IsVisible="{Binding HasSources}">
      <DockPanel>
      <!-- Collapsed: one line of dots and names instead of cards -->
      <Button DockPanel.Dock="Left" Classes="icon" Margin="6,0,0,0" VerticalAlignment="Center"
              Click="ToggleNodes_Click" ToolTip.Tip="{app:T 'Свернуть или развернуть ноды'}">
        <Panel>
          <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" IsVisible="{Binding !NodesCollapsed}" />
          <PathIcon Data="{StaticResource IconChevronRight}" Width="12" Height="12" IsVisible="{Binding NodesCollapsed}" />
        </Panel>
      </Button>
      <ItemsControl ItemsSource="{Binding Nodes}" Margin="4,6" IsVisible="{Binding NodesCollapsed}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="app:ResourceRow">
            <Border Classes="chip" Cursor="Hand" BorderThickness="1"
                    BorderBrush="{Binding IsFilterActive, Converter={x:Static app:Converters.FilterBorder}}"
                    PointerPressed="Node_PointerPressed" ContextRequested="Node_ContextRequested">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Health, Converter={x:Static app:Converters.HealthDot}}" />
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding Cpu, StringFormat='{}{0:0}%'}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !NodesCollapsed}">
        <ItemsControl ItemsSource="{Binding Nodes}" Margin="6,10,12,10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:ResourceRow">
              <Border Classes="node" BorderBrush="{Binding IsFilterActive, Converter={x:Static app:Converters.FilterBorder}}"
                      Opacity="{Binding Stale, Converter={x:Static app:Converters.StaleOpacity}}"
                      PointerPressed="Node_PointerPressed" ContextRequested="Node_ContextRequested">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding GuestsText}" />
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding Health, Converter={x:Static app:Converters.HealthDot}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </DockPanel>
                  <Grid ColumnDefinitions="40,*,64" RowDefinitions="20,20">
                    <TextBlock Classes="k" Text="CPU" />
                    <app:Sparkline Grid.Column="1" Height="16" Values="{Binding CpuRecent}" Capacity="60"
                                   Stroke="{Binding Cpu, Converter={x:Static app:Converters.LoadBrush}}" />
                    <TextBlock Grid.Column="2" Classes="v" Text="{Binding Cpu, StringFormat='{}{0:0}%'}" />
                    <TextBlock Grid.Row="1" Classes="k" Text="RAM" />
                    <ProgressBar Grid.Row="1" Grid.Column="1" Classes="thin" Value="{Binding MemPct}"
                                 Foreground="{Binding MemPct, Converter={x:Static app:Converters.LoadBrush}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="v" Text="{Binding MemPct, StringFormat='{}{0:0}%'}" />
                  </Grid>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Text="{Binding UptimeText}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding TempText}"
                               Foreground="{Binding Temp, Converter={x:Static app:Converters.TempBrush}}" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <Panel>
      <SplitView IsPaneOpen="{Binding IsLogOpen}" PanePlacement="Right" DisplayMode="Inline"
                 OpenPaneLength="300" PaneBackground="{DynamicResource Surface}">
        <SplitView.Pane>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,12,8,8">
                <Button DockPanel.Dock="Right" Classes="icon" Content="{app:T 'Очистить'}" FontSize="12"
                        Command="{Binding ClearEventsCommand}" />
                <TextBlock Text="{app:T 'Журнал событий'}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <ListBox Classes="log" ItemsSource="{Binding Events}" Background="Transparent" DoubleTapped="Log_DoubleTapped"
                       ToolTip.Tip="{app:T 'Двойной клик — показать сервер в таблице'}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:AlertEvent">
                    <DockPanel>
                      <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,6,10,0" VerticalAlignment="Top"
                               Fill="{Binding Severity, Converter={x:Static app:Converters.SeverityBrush}}" />
                      <StackPanel Spacing="1">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                     Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" />
                          <TextBlock Text="{Binding ResourceName}" FontSize="13" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Classes="muted" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </SplitView.Pane>

        <DockPanel>
        <!-- Inspector: the selected VM or node and what can be done with it -->
        <Border DockPanel.Dock="Right" Width="300" IsVisible="{Binding InspectorOpen}"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
          <Panel>
            <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                        VerticalAlignment="Center" Margin="32" Spacing="6">
              <TextBlock Text="{app:T 'Ничего не выбрано'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                         Text="{app:T 'Выберите VM в таблице или ноду сверху, чтобы увидеть её состояние и действия'}" />
            </StackPanel>
            <ContentControl Content="{Binding Selected}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <ScrollViewer>
                    <StackPanel Margin="20,18" Spacing="20">
                      <StackPanel Spacing="6">
                        <Border Classes="pill" HorizontalAlignment="Left" Background="{Binding Health, Converter={x:Static app:Converters.HealthPill}}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Health, Converter={x:Static app:Converters.HealthDot}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" />
                          </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" FontSize="12">
                          <Run Text="{Binding KindText}" /><Run Text="{app:T ', нода '}" /><Run Text="{Binding Node}" />
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="v" Text="{Binding Cpu, StringFormat='{}{0:0}%'}" />
                            <TextBlock Classes="k" Text="CPU" />
                          </DockPanel>
                          <app:Sparkline Height="40" Values="{Binding CpuRecent}" Capacity="60" Fill="True"
                                         Stroke="{Binding Cpu, Converter={x:Static app:Converters.LoadBrush}}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="v" Text="{Binding MemText}" />
                            <TextBlock Classes="k" Text="{app:T 'Память'}" />
                          </DockPanel>
                          <ProgressBar Classes="thin" Value="{Binding MemPct}" Foreground="{Binding MemPct, Converter={x:Static app:Converters.LoadBrush}}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="v" Text="{Binding DiskText}" />
                            <TextBlock Classes="k" Text="{app:T 'Диск'}" />
                          </DockPanel>
                          <ProgressBar Classes="thin" Value="{Binding DiskPct}" Foreground="{Binding DiskPct, Converter={x:Static app:Converters.LoadBrush}}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="k" Text="{app:T 'Температура'}" />
                            <TextBlock Classes="v" Text="{Binding TempText}" Foreground="{Binding Temp, Converter={x:Static app:Converters.TempBrush}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="k" Text="{app:T 'Аптайм'}" />
                            <TextBlock Classes="v" Text="{Binding UptimeText}" />
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                            <TextBlock Classes="k" Text="{app:T 'Сеть'}" />
                            <TextBlock Classes="v" Text="{Binding NetText}" />
                          </StackPanel>
                          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                            <TextBlock Classes="k" Text="{app:T 'IP-адрес'}" />
                            <SelectableTextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding AddressText}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>

                      <StackPanel Spacing="6">
                        <Button Classes="inspector accent" Content="{app:T 'Запустить'}" IsVisible="{Binding CanStart}" Click="InspectorStart_Click" />
                        <Button Classes="inspector" Content="{app:T 'Перезагрузить…'}" IsVisible="{Binding CanStop}" Click="InspectorReboot_Click" />
                        <Button Classes="inspector" Content="{app:T 'Остановить…'}" IsVisible="{Binding CanStop}" Click="InspectorStop_Click" />
                        <Button Classes="inspector" Content="{app:T 'Создать снапшот'}" IsVisible="{Binding IsGuest}" Click="InspectorSnapshot_Click" />
                        <Button Classes="inspector" Content="{app:T 'Терминал'}" Click="InspectorTerminal_Click" />
                        <Button Classes="inspector" Content="{app:T 'Добавить виджет'}" Click="InspectorWidget_Click" />
                        <Button Classes="inspector" Content="{app:T 'Свойства'}" Click="InspectorProperties_Click" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Panel>
        </Border>

        <DataGrid x:Name="ResourceGrid" ItemsSource="{Binding View}" IsVisible="{Binding HasSources}"
                  IsReadOnly="True" SelectionMode="Extended"
                  CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="36"
                  FrozenColumnCount="2" DoubleTapped="Grid_DoubleTapped" SelectionChanged="Grid_SelectionChanged">
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="app:ResourceRow">
              <Setter Property="Opacity" Value="{Binding Stale, Converter={x:Static app:Converters.StaleOpacity}}" />
              <Setter Property="Background" Value="{Binding Health, Converter={x:Static app:Converters.HealthTint}}" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.ContextMenu>
            <ContextMenu Opening="RowMenu_Opening">
              <MenuItem x:Name="StartItem" Header="{app:T 'Запустить'}" Click="Start_Click" />
              <MenuItem x:Name="RebootItem" Header="{app:T 'Перезагрузить…'}" Click="Reboot_Click" />
              <MenuItem x:Name="StopItem" Header="{app:T 'Остановить…'}" Click="Stop_Click" />
              <MenuItem x:Name="SnapshotItem" Header="{app:T 'Создать снапшот'}" Click="Snapshot_Click" />
              <Separator x:Name="PowerSeparator" />
              <MenuItem x:Name="SectionMenu" Header="{app:T 'Переместить в раздел'}" />
              <MenuItem x:Name="MoveMenu" Header="{app:T 'Переместить во вкладку'}" />
              <MenuItem Header="{app:T 'Добавить виджет'}" Click="AddWidget_Click" />
              <Separator />
              <!-- Last, like Properties in Windows menus. -->
              <MenuItem Header="{app:T 'Свойства'}" Click="Details_Click" FontWeight="SemiBold" />
            </ContextMenu>
          </DataGrid.ContextMenu>

          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{app:T 'Статус'}" SortMemberPath="Running" Width="132">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <Border Classes="pill" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{Binding Health, Converter={x:Static app:Converters.HealthPill}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Health, Converter={x:Static app:Converters.HealthDot}}" />
                      <TextBlock Text="{Binding StatusText}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Имя'}" SortMemberPath="Name" Width="*" MinWidth="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="12,0" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Тип'}" SortMemberPath="KindText" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Classes="muted" Text="{Binding KindText}" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Нода'}" SortMemberPath="Node" Width="86">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Classes="muted" Text="{Binding Node}" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="CPU" SortMemberPath="Cpu" Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <Grid ColumnDefinitions="40,*" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cpu, StringFormat='{}{0:0}%'}" />
                    <app:Sparkline Grid.Column="1" Height="18" Values="{Binding CpuRecent}" Capacity="60"
                                   Stroke="{Binding Cpu, Converter={x:Static app:Converters.LoadBrush}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="RAM" SortMemberPath="MemPct" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <Grid ColumnDefinitions="40,*" Margin="12,0" Background="Transparent" ToolTip.Tip="{Binding MemText}">
                    <TextBlock Text="{Binding MemPct, StringFormat='{}{0:0}%'}" />
                    <ProgressBar Grid.Column="1" Classes="thin" Value="{Binding MemPct}"
                                 Foreground="{Binding MemPct, Converter={x:Static app:Converters.LoadBrush}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Диск'}" SortMemberPath="DiskPct" Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <Grid ColumnDefinitions="40,*" Margin="12,0" Background="Transparent" ToolTip.Tip="{Binding DiskText}">
                    <TextBlock Text="{Binding DiskPct, StringFormat='{}{0:0}%'}" />
                    <ProgressBar Grid.Column="1" Classes="thin" Value="{Binding DiskPct}"
                                 Foreground="{Binding DiskPct, Converter={x:Static app:Converters.LoadBrush}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Темп.'}" SortMemberPath="Temp" Width="86">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Text="{Binding TempText}" FontWeight="Medium" Margin="12,0"
                             Foreground="{Binding Temp, Converter={x:Static app:Converters.TempBrush}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Сеть'}" SortMemberPath="NetTotal" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Classes="muted" Text="{Binding NetText}" FontSize="12" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Подкл.'}" SortMemberPath="Connections" Width="92">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Text="{Binding ConnectionsText}" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{app:T 'Аптайм'}" SortMemberPath="Uptime" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="app:ResourceRow">
                  <TextBlock Classes="muted" Text="{Binding UptimeText}" Margin="12,0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </SplitView>

      <!-- Widgets float over the table; the empty canvas lets clicks through. -->
      <ItemsControl x:Name="WidgetLayer" ItemsSource="{Binding Widgets}" ClipToBounds="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ItemsControl#WidgetLayer > ContentPresenter" x:DataType="app:WidgetVm">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="app:WidgetVm">
            <Border Classes="widget"
                    PointerPressed="Widget_PointerPressed" PointerMoved="Widget_PointerMoved"
                    PointerReleased="Widget_PointerReleased" ContextRequested="Widget_ContextRequested">
              <Panel>
              <!-- Built in the widget builder: title, then the kind's own content -->
              <StackPanel Spacing="8" IsVisible="{Binding !IsServer}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding IsList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:WidgetLine">
                      <StackPanel Spacing="3" Margin="0,0,0,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Classes="v" Text="{Binding Value}" />
                          <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Fill="{Binding Row.Health, Converter={x:Static app:Converters.HealthDot}}" />
                          <TextBlock FontSize="12" Text="{Binding Row.Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Classes="thin" Value="{Binding Pct}" Foreground="{Binding Pct, Converter={x:Static app:Converters.LoadBrush}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" IsVisible="{Binding IsSummary}">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="k" Text="{app:T 'Запущено'}" />
                    <TextBlock Classes="v" FontSize="16" Text="{Binding SummaryRunning}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="k" Text="{app:T 'Средний CPU'}" />
                    <TextBlock Classes="v" FontSize="16" Text="{Binding SummaryCpu}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="1">
                    <TextBlock Classes="k" Text="{app:T 'Макс. темп.'}" />
                    <TextBlock Classes="v" FontSize="16" Text="{Binding SummaryTemp}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                    <TextBlock Classes="k" Text="{app:T 'Проблемы'}" />
                    <TextBlock Classes="v" FontSize="16" Foreground="#F59E0B" Text="{Binding SummaryProblems}" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="6" IsVisible="{Binding IsCommand}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent" Padding="10,3" FontSize="12" Content="{app:T 'Выполнить'}"
                            IsEnabled="{Binding !CommandBusy}" Click="WidgetRun_Click" />
                    <TextBlock Classes="k" TextTrimming="CharacterEllipsis" Text="{Binding Row.Name, FallbackValue='—'}" />
                  </DockPanel>
                  <Border Background="#0E1014" CornerRadius="6" Padding="8,6">
                    <StackPanel Spacing="4">
                      <TextBlock FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" Foreground="#91A7FF"
                                 Text="{Binding Config.Command, StringFormat='$ {0}'}" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11" Foreground="#C9CED8"
                                 TextWrapping="Wrap" MaxHeight="120" Text="{Binding CommandOutput}"
                                 IsVisible="{Binding CommandOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="k" FontSize="11" Text="{Binding CommandStatus}"
                             IsVisible="{Binding CommandStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="7" IsVisible="{Binding IsServer}">
                <DockPanel>
                  <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{Binding Row.Health, Converter={x:Static app:Converters.HealthDot}, FallbackValue=Gray}" />
                  <TextBlock Text="{Binding Row.Name, FallbackValue='—'}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid ColumnDefinitions="52,44,*" IsVisible="{Binding Cpu}">
                  <TextBlock Classes="k" Text="CPU" />
                  <TextBlock Grid.Column="1" Classes="v" Text="{Binding Row.Cpu, StringFormat='{}{0:0}%'}" />
                  <app:Sparkline Grid.Column="2" Height="16" Values="{Binding Row.CpuRecent}" Capacity="60"
                                 Stroke="{Binding Row.Cpu, Converter={x:Static app:Converters.LoadBrush}}" />
                </Grid>
                <Grid ColumnDefinitions="52,44,*" IsVisible="{Binding Ram}">
                  <TextBlock Classes="k" Text="RAM" />
                  <TextBlock Grid.Column="1" Classes="v" Text="{Binding Row.MemPct, StringFormat='{}{0:0}%'}" />
                  <ProgressBar Grid.Column="2" Classes="thin" Value="{Binding Row.MemPct}"
                               Foreground="{Binding Row.MemPct, Converter={x:Static app:Converters.LoadBrush}}" />
                </Grid>
                <Grid ColumnDefinitions="52,44,*" IsVisible="{Binding Disk}">
                  <TextBlock Classes="k" Text="{app:T 'Диск'}" />
                  <TextBlock Grid.Column="1" Classes="v" Text="{Binding Row.DiskPct, StringFormat='{}{0:0}%'}" />
                  <ProgressBar Grid.Column="2" Classes="thin" Value="{Binding Row.DiskPct}"
                               Foreground="{Binding Row.DiskPct, Converter={x:Static app:Converters.LoadBrush}}" />
                </Grid>
                <Grid ColumnDefinitions="52,*" IsVisible="{Binding Temp}">
                  <TextBlock Classes="k" Text="{app:T 'Темп.'}" />
                  <TextBlock Grid.Column="1" Classes="v" Text="{Binding Row.TempText}"
                             Foreground="{Binding Row.Temp, Converter={x:Static app:Converters.TempBrush}}" />
                </Grid>
                <Grid ColumnDefinitions="52,*" IsVisible="{Binding Net}">
                  <TextBlock Classes="k" Text="{app:T 'Сеть'}" />
                  <TextBlock Grid.Column="1" Classes="v" FontWeight="Normal" Text="{Binding Row.NetText}" />
                </Grid>
              </StackPanel>
              </Panel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding !HasSources}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="{app:T 'Нет подключённых серверов'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{app:T 'Подключите Proxmox по API-токену или откройте демо-кластер'}" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Button Classes="accent" Content="{app:T 'Подключить сервер'}" Click="ConnectServer" Padding="16,8" CornerRadius="8" />
          <Button Content="{app:T 'Открыть демо'}" Click="OpenDemo" Padding="16,8" CornerRadius="8" />
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
