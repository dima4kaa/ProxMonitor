<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ProxMonitor.App"
        xmlns:core="using:ProxMonitor.Core"
        x:Class="ProxMonitor.App.PropertiesWindow"
        x:DataType="app:ResourceRow"
        Icon="/Assets/app.ico"
        Width="920" Height="860" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="app|Sparkline.chart">
      <Setter Property="Height" Value="120" />
      <Setter Property="ShowGrid" Value="True" />
      <Setter Property="Fill" Value="True" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </Window.Styles>

  <!-- Maximized with an extended client area, the window spills past the screen by OffScreenMargin. -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">
  <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="Transparent">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
      <Image Source="/Assets/app.ico" Width="16" Height="16" />
      <TextBlock Classes="muted" FontSize="12" Text="{app:T 'Свойства'}" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
  <ScrollViewer>
    <StackPanel Margin="24,4,24,24" Spacing="16">
      <!-- Header -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Click="OpenTerminal" VerticalAlignment="Center"
                Margin="20,0,0,0" Padding="14,7" CornerRadius="8" Content="{app:T 'Терминал'}" />
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="{app:T 'Аптайм'}" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding UptimeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{Binding Running, Converter={x:Static app:Converters.StatusBrush}}" />
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Classes="muted">
            <Run Text="{Binding KindText}" /><Run Text="{app:T ' · нода '}" /><Run Text="{Binding Node}" /><Run Text=" · " /><Run Text="{Binding StatusText}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <!-- Charts -->
      <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="label" Text="CPU" />
            <TextBlock Classes="value" Text="{Binding Cpu, StringFormat='{}{0:0}%'}" />
            <app:Sparkline Classes="chart" Values="{Binding CpuHistory}" Maximum="100" Stroke="#5C7CFA" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <StackPanel>
            <TextBlock Classes="label" Text="{app:T 'Память'}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="value" Text="{Binding MemPct, StringFormat='{}{0:0}%'}" />
              <TextBlock Classes="muted" Text="{Binding MemText}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
            <app:Sparkline Classes="chart" Values="{Binding MemHistory}" Maximum="100" Stroke="#A855F7" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
          <StackPanel>
            <TextBlock Classes="label" Text="{app:T 'Сеть: вход (синий) и выход (зелёный)'}" />
            <TextBlock Classes="value" Text="{Binding NetText}" />
            <Panel>
              <app:Sparkline Classes="chart" Values="{Binding NetInHistory}" Maximum="{Binding NetScale}" Stroke="#5C7CFA" />
              <app:Sparkline Classes="chart" Values="{Binding NetOutHistory}" Maximum="{Binding NetScale}" Stroke="#22C55E" Fill="False" ShowGrid="False" />
            </Panel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Classes="card">
          <StackPanel>
            <TextBlock Classes="label" Text="{app:T 'Температура'}" />
            <TextBlock Classes="value" Text="{Binding TempText}"
                       Foreground="{Binding Temp, Converter={x:Static app:Converters.TempBrush}}" />
            <Panel>
              <app:Sparkline Classes="chart" Values="{Binding TempHistory}" Maximum="100" Stroke="#F59E0B"
                             IsVisible="{Binding Temp, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding Temp, Converter={x:Static ObjectConverters.IsNull}}"
                         Text="{app:T 'Датчиков нет: температура есть только у нод и требует SSH и lm-sensors'}" />
            </Panel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Facts -->
      <Border Classes="card">
        <UniformGrid Columns="5">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{app:T 'Диск'}" />
            <TextBlock Text="{Binding DiskText}" FontWeight="SemiBold" />
            <ProgressBar Classes="thin" Value="{Binding DiskPct}" Margin="0,6,24,0"
                         Foreground="{Binding DiskPct, Converter={x:Static app:Converters.LoadBrush}}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{app:T 'Подключения'}" />
            <TextBlock Text="{Binding ConnectionsText}" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{app:T 'ID в Proxmox'}" />
            <TextBlock Text="{Binding LocalId}" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{app:T 'IP-адрес'}" />
            <SelectableTextBlock x:Name="IpText" Text="…" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{app:T 'Нода'}" />
            <TextBlock Text="{Binding Node}" FontWeight="SemiBold" />
          </StackPanel>
        </UniformGrid>
      </Border>

      <!-- Active connections, read with ss on the server -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{app:T 'Обновить'}" Click="RefreshConnections_Click" Padding="12,4" />
            <StackPanel Spacing="2">
              <TextBlock Text="{app:T 'Активные подключения'}" FontWeight="SemiBold" />
              <TextBlock x:Name="ConnectionsHint" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Grid x:Name="ConnectionsHeader" ColumnDefinitions="80,*,*,*" IsVisible="False">
            <TextBlock Classes="label" Text="{app:T 'Протокол'}" />
            <TextBlock Grid.Column="1" Classes="label" Text="{app:T 'Адрес сервера'}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{app:T 'Откуда подключились'}" />
            <TextBlock Grid.Column="3" Classes="label" Text="{app:T 'Программа'}" />
          </Grid>
          <ItemsControl x:Name="ConnectionsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:NetConnection">
                <Grid ColumnDefinitions="80,*,*,*" Margin="0,3">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Proto}" />
                  <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Local}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Peer}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold" Text="{Binding Process}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Own danger levels -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <DockPanel>
            <CheckBox x:Name="OwnBox" DockPanel.Dock="Right" Content="{app:T 'Свои значения'}" IsCheckedChanged="Thresholds_Changed" />
            <StackPanel Spacing="2">
              <TextBlock Text="{app:T 'Пороги предупреждений'}" FontWeight="SemiBold" />
              <TextBlock x:Name="ThresholdsHint" Classes="muted" FontSize="12" />
            </StackPanel>
          </DockPanel>
          <UniformGrid x:Name="ThresholdsBoxes" Columns="3">
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="label" Text="CPU, %" />
              <NumericUpDown x:Name="CpuBox" Minimum="1" Maximum="100" Increment="5" FormatString="0" ValueChanged="Thresholds_Changed" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="label" Text="{app:T 'Температура, °C'}" />
              <NumericUpDown x:Name="TempBox" Minimum="30" Maximum="120" Increment="5" FormatString="0" ValueChanged="Thresholds_Changed" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{app:T 'Диск, %'}" />
              <NumericUpDown x:Name="DiskBox" Minimum="1" Maximum="100" Increment="5" FormatString="0" ValueChanged="Thresholds_Changed" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Events -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{app:T 'События'}" FontWeight="SemiBold" />
          <TextBlock x:Name="NoEvents" Classes="muted" FontSize="12" Text="{app:T 'Пока ничего не происходило'}" />
          <ItemsControl x:Name="EventsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:AlertEvent">
                <DockPanel Margin="0,4">
                  <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                           Fill="{Binding Severity, Converter={x:Static app:Converters.SeverityBrush}}" />
                  <TextBlock DockPanel.Dock="Left" Classes="muted" FontSize="12" Width="70" VerticalAlignment="Center"
                             Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" />
                  <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" FontSize="11" Text="{app:T 'Графики показывают историю с момента запуска приложения, до 10 минут.'}" />
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</Window>
